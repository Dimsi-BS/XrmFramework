<Project>
    <!--
      Détection du package Microsoft.PowerPlatform.Dataverse.Client dans le projet en cours de compilation.

      Le package XrmFramework livre ses sources en contentFiles : elles sont donc compilées dans le projet
      consommateur, qui ne référence pas toujours le client Dataverse (projet plugin net462, projet Core
      On-Premise via Microsoft.CrmSdk.XrmTooling.CoreAssembly, ...). Le code qui dépend de
      IOrganizationServiceAsync / IOrganizationServiceAsync2 est encadré par « #if DATAVERSE_CLIENT ».

      La détection se fait dans une cible : MSBuild n'autorise les références d'items (@(PackageReference))
      que dans les cibles, pas au moment de l'évaluation des PropertyGroup. Définir
      XrmFramework_HasDataverseClient à true ou false dans le csproj (ou dans un Directory.Build.props)
      court-circuite la détection.
    -->
    <Target Name="XrmFramework_DetectDataverseClient" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <XrmFramework_HasDataverseClient Condition="'$(XrmFramework_HasDataverseClient)' == ''">@(PackageReference->AnyHaveMetadataValue('Identity', 'Microsoft.PowerPlatform.Dataverse.Client'))</XrmFramework_HasDataverseClient>

            <DefineConstants Condition="'$(XrmFramework_HasDataverseClient)' == 'true'">$(DefineConstants);DATAVERSE_CLIENT</DefineConstants>
        </PropertyGroup>
    </Target>
</Project>
