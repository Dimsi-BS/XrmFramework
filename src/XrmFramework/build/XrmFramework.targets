<Project>
    <!--
      Detects the Microsoft.PowerPlatform.Dataverse.Client package in the project being compiled.

      The XrmFramework package ships its sources as contentFiles: they are therefore compiled into the
      consuming project, which does not always reference the Dataverse client (net462 plugin project,
      On-Premise Core project via Microsoft.CrmSdk.XrmTooling.CoreAssembly, ...). Code that depends on
      IOrganizationServiceAsync / IOrganizationServiceAsync2 is guarded by "#if DATAVERSE_CLIENT".

      Detection happens in a target: MSBuild only allows item references (@(PackageReference))
      inside targets, not during PropertyGroup evaluation. Setting
      XrmFramework_HasDataverseClient to true or false in the csproj (or in a Directory.Build.props)
      short-circuits the detection.
    -->
    <Target Name="XrmFramework_DetectDataverseClient" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <XrmFramework_HasDataverseClient Condition="'$(XrmFramework_HasDataverseClient)' == ''">@(PackageReference->AnyHaveMetadataValue('Identity', 'Microsoft.PowerPlatform.Dataverse.Client'))</XrmFramework_HasDataverseClient>

            <DefineConstants Condition="'$(XrmFramework_HasDataverseClient)' == 'true'">$(DefineConstants);DATAVERSE_CLIENT</DefineConstants>
        </PropertyGroup>
    </Target>
</Project>
