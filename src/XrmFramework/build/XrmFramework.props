<Project>
    <ItemGroup>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)/../content/tables/**/*.table" Link="__Imports\XrmFramework\%(RecursiveDir)%(Filename)%(Extension)" />

        <Compile Remove="**\*.table" />
        <None Remove="**\*.table" />
        <AdditionalFiles Include="**/*.table" />

        <!-- Binding models are declared the same way tables are, and the generator needs both:
             a .model names the table it maps to. Only the project that declares them compiles
             them; a downstream project consumes the generated classes through its reference. -->
        <Compile Remove="**\*.model" />
        <None Remove="**\*.model" />
        <AdditionalFiles Include="**/*.model" />

        <Compile Remove="Generated\**" />
    </ItemGroup>

    <PropertyGroup Condition="'$(XrmFrameworkShowGeneratedFiles)' == 'true'">
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(XrmFrameworkShowGeneratedFiles)' == 'true'">
        <None Include="Generated\**" />
    </ItemGroup>

    <PropertyGroup>
        <ImplicitUsings>true</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="System" />
        <Using Include="System.Net.Http" />
        <Using Include="XrmFramework" />
        <Using Include="XrmFramework.BindingModel" />
    </ItemGroup>
</Project>
