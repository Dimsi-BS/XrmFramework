<Project>
  <Target Name="SetNuspecProperties" BeforeTargets="GenerateNuspec" DependsOnTargets="GetBuildVersion">
    <PropertyGroup>
      <NuspecProperties>$(NuspecProperties);config=$(Configuration)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);version=$(NuGetPackageVersion)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);SolutionDir=$(SolutionDir)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);copyright=$(XrmFramework_Copyright)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);author=$(XrmFramework_Authors)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);owner=$(XrmFramework_Owners)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);commit=$(GitCommitId)</NuspecProperties>

      <NuspecProperties>$(NuspecProperties);XrmFramework_FullFramework_Runtime_TFM=$(XrmFramework_FullFramework_Runtime_TFM)</NuspecProperties>

      <!-- Versions des dépendances tierces — source unique de vérité : Directory.Packages.props -->
      <NuspecProperties>$(NuspecProperties);Ver_DataverseClient=$(Ver_DataverseClient)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_CrmSdkCoreAssemblies=$(Ver_CrmSdkCoreAssemblies)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_CrmSdkWorkflow=$(Ver_CrmSdkWorkflow)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_CrmSdkXrmTooling=$(Ver_CrmSdkXrmTooling)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_NewtonsoftJson=$(Ver_NewtonsoftJson)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_ExtDependencyInjection=$(Ver_ExtDependencyInjection)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_MicrosoftCSharp=$(Ver_MicrosoftCSharp)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_SysComponentAnnotations=$(Ver_SysComponentAnnotations)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_SysConfigurationManager=$(Ver_SysConfigurationManager)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_SysNetHttp=$(Ver_SysNetHttp)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_CommandLineParser=$(Ver_CommandLineParser)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_SpectreConsole=$(Ver_SpectreConsole)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_AzureRelay=$(Ver_AzureRelay)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_NETTestSdk=$(Ver_NETTestSdk)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_NUnit=$(Ver_NUnit)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_NUnit3Adapter=$(Ver_NUnit3Adapter)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_Moq=$(Ver_Moq)</NuspecProperties>
      <NuspecProperties>$(NuspecProperties);Ver_TypeScriptMSBuild=$(Ver_TypeScriptMSBuild)</NuspecProperties>
    </PropertyGroup>

    <ItemGroup>
      <FilesToModify Remove="@(FilesToModify)" />
      <FilesToModify Include="**/templates/**/*.csproj"/>
    </ItemGroup>

    <MSBuild Condition="@(FilesToModify->Count()) > 0" Projects="$(MSBuildProjectFile)" Properties="CurrentCsProj=%(FilesToModify.FullPath);searchedPattern=#{GitBuildVersionSimple}#;NuGetPackageVersion=$(NuGetPackageVersion)" Targets="ReplaceCsprojVersion">
    </MSBuild>
  </Target>

  <Target Name="CleanupNupkgs" BeforeTargets="Build">
    <ItemGroup>
      <Nupkgs2Delete Include="$(PackageOutputAbsolutePath)\*.nupkg"/>
    </ItemGroup>
    <Delete Files="@(Nupkgs2Delete)" />
  </Target>



  <Target Name="ModifyTemplateDependencyVersion" AfterTargets="Pack" DependsOnTargets="GetBuildVersion">
    <Message Importance="High" Text="NuGetPackageVersion = $(NuGetPackageVersion)" />
    <ItemGroup>
      <FilesToModify Remove="@(FilesToModify)" />
      <FilesToModify Include="**/templates/**/*.csproj"/>

    </ItemGroup>

    <MSBuild Condition="@(FilesToModify->Count()) > 0" Projects="$(MSBuildProjectFile)" Properties="CurrentCsProj=%(FilesToModify.FullPath);searchedPattern=$(NuGetPackageVersion);NuGetPackageVersion=#{GitBuildVersionSimple}#" Targets="ReplaceCsprojVersion">
    </MSBuild>
  </Target>


  <!-- This target checks the current analyzed file $(CurrentXmlFile) -->
  <Target Name="ReplaceCsprojVersion">
    <ItemGroup>
      <ItemsFromFile Include="$([System.IO.File]::ReadAllText($(CurrentCsProj)))"/>
    </ItemGroup>

    <ItemGroup>
      <TempLines Include="@(ItemsFromFile->Replace('$(searchedPattern)', $(NuGetPackageVersion)))" />
    </ItemGroup>

    <WriteLinesToFile File="$(CurrentCsProj)" Lines="@(TempLines)" Overwrite="true"/>
  </Target>

  <Target Name="CopyNupkgToFolder" AfterTargets="Pack">
    <ItemGroup>
      <GeneratedNupkgs Include="$(PackageOutputAbsolutePath)\*.nupkg"/>
      <GeneratedNupkgs Include="$(PackageOutputAbsolutePath)\*.snupkg"/>
    </ItemGroup>
    <Copy SourceFiles="@(GeneratedNupkgs)" DestinationFolder="$(SolutionDir)GeneratedNuGetPackages\$(Configuration)" />

  </Target>
</Project>
