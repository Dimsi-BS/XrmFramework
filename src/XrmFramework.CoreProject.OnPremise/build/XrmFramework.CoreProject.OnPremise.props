<Project>
    <PropertyGroup>
        <DefineConstants>$(DefineConstants);CORE_PROJECT;ON_PREMISE</DefineConstants>

        <!-- On-premise goes through Microsoft.CrmSdk.XrmTooling.CoreAssembly, never through the
             Dataverse client. We state the result of the XrmFramework.targets detection instead of
             letting it scan @(PackageReference). -->
        <XrmFramework_HasDataverseClient>false</XrmFramework_HasDataverseClient>
    </PropertyGroup>
</Project>
