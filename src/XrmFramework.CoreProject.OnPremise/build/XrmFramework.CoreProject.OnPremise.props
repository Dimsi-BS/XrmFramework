<Project>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

    <ItemGroup>
        <PackageReference Remove="Microsoft.PowerPlatform.Dataverse.Client" />
        <PackageReference Remove="Microsoft.PowerPlatform.Dataverse.Client.Dynamics" />
    </ItemGroup>
    
    <PropertyGroup>
        <DefineConstants>$(DefineConstants);CORE_PROJECT;ON_PREMISE</DefineConstants>

        <!-- The Dataverse client is removed above: we short-circuit detection from XrmFramework.targets
             so we don't depend on the import order of package .props files. -->
        <XrmFramework_HasDataverseClient>false</XrmFramework_HasDataverseClient>
    </PropertyGroup>
</Project>
