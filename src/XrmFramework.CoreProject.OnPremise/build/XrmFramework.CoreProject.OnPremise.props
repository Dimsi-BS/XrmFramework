<Project>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

    <ItemGroup>
        <PackageReference Remove="Microsoft.PowerPlatform.Dataverse.Client" />
        <PackageReference Remove="Microsoft.PowerPlatform.Dataverse.Client.Dynamics" />
    </ItemGroup>
    
    <PropertyGroup>
        <DefineConstants>$(DefineConstants);CORE_PROJECT;ON_PREMISE</DefineConstants>

        <!-- Le client Dataverse est retiré ci-dessus : on court-circuite la détection de XrmFramework.targets
             pour ne pas dépendre de l'ordre d'import des .props de packages. -->
        <XrmFramework_HasDataverseClient>false</XrmFramework_HasDataverseClient>
    </PropertyGroup>
</Project>
