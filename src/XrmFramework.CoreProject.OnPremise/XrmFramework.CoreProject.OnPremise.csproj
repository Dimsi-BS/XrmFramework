<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>XrmFramework.CoreProject</AssemblyName>
    <AssemblyOriginatorKeyFile>$(XrmFramework_KeyFile)</AssemblyOriginatorKeyFile>
    <SignAssembly>$(XrmFramework_EnableStrongNameSigning)</SignAssembly>
    <PublicSign>$(XrmFramework_PublicSign)</PublicSign>
    <PackageId>XrmFramework.CoreProject</PackageId>


    <NuspecFile>$(MSBuildThisFileDirectory)XrmFramework.CoreProject.OnPremise.nuspec</NuspecFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>


    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <NoWarn>$(NoWarn);1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);DEPENDENCY_INJECTION;CORE_PROJECT;ON_PREMISE</DefineConstants>
  </PropertyGroup>

  <ItemGroup >
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.ComponentModel.DataAnnotations" />

    <PackageReference Include="Microsoft.CSharp" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="System.Net.Http" />
    <PackageReference Include="System.ComponentModel.Annotations" />

    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Microsoft.CrmSdk.XrmTooling.CoreAssembly" />
    <PackageReference Include="System.Text.RegularExpressions" />
    <!-- Remonte le plancher transitif de Microsoft.CrmSdk.CoreAssemblies (6.0.7, CVE-2024-43485). -->
    <PackageReference Include="System.Text.Json" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.Reflection.DispatchProxy" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\XrmFramework\**\*.cs" Link="_Imports\XrmFramework\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\XrmFramework\bin\**;..\XrmFramework\obj\**" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\XrmFramework.Analyzers\XrmFramework.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\XrmFramework.Analyzers.CodeFixes\XrmFramework.Analyzers.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="../XrmFramework/**/*.table" Exclude="../XrmFramework/bin/**;../XrmFramework/obj/**" />
  </ItemGroup>

</Project>
