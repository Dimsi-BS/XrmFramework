<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

  <ItemGroup>
    <!-- Version consumed by build/netstandard2.0/XrmFramework.TypeScript.props -->
    <XrmFrameworkShippedVersion Include="Ver_TypeScriptMSBuild" Value="$(Ver_TypeScriptMSBuild)" />
  </ItemGroup>

    <PropertyGroup>

        <AssemblyName>XrmFramework.TypeScript</AssemblyName>
        <AssemblyOriginatorKeyFile>$(XrmFramework_KeyFile)</AssemblyOriginatorKeyFile>
        <PackageId>XrmFramework.TypeScript</PackageId>

        <NuspecFile>$(MSBuildThisFileDirectory)XrmFramework.TypeScript.nuspec</NuspecFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Framework" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" />
        <PackageReference Include="Newtonsoft.Json" />
    </ItemGroup>


</Project>
