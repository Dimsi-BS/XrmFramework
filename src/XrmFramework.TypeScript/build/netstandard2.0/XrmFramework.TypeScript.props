<Project>
    <Import Project="$(MSBuildThisFileDirectory)XrmFrameworkVersions.props" />

    <ItemGroup>
        <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="$(XrmFrameworkVer_TypeScriptMSBuild)">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
