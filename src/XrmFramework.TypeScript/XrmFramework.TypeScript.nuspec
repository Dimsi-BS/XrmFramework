<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
    <metadata>
        <id>XrmFramework.TypeScript</id>
        <version>$version$</version>
        <title>XrmFramework.TypeScript</title>
        <authors>$author$</authors>
        <owners>$owner$</owners>
        <description>XrmFramework aims at simplifying Microsoft Dynamics 365  and Dataverse plugin, workflows development, deployment and testing</description>
        <summary>XrmFramework aims at simplifying Microsoft Dynamics 365 and Dataverse plugin, workflows development, deployment and testing</summary>
        <language>en-US</language>
        <projectUrl>https://aka.ms/XrmFramework</projectUrl>
        <license type="expression">MIT</license>
        <tags>Dynamics365 CRM DynamicsCrm Dataverse PowerApps</tags>
        <copyright>$copyright$</copyright>
        <dependencies>
            <group targetFramework="netstandard2.0">
                <dependency id="Microsoft.TypeScript.MSBuild" version="$Ver_TypeScriptMSBuild$" />
            </group>
        </dependencies>
    </metadata>

    <files>
        <file src="build\**\*" target="build\"
              exclude="build\netstandard2.0\typescripts\tables.d.ts;build\netstandard2.0\typescripts\enums.ts" />

        <file src="bin\$config$\netstandard2.0\XrmFramework.TypeScript.dll" target="build\netstandard2.0\" />

        <!--
            The .table files the framework ships, the same ones the XrmFramework package packs under
            content\tables and hands to the C# source generator. The TypeScript definitions are
            generated from them alongside the project's own copies, so that both generators fold the
            same declarations: without them, a table the project tracks a copy of was described to
            TypeScript by that copy alone.

            Shipped here rather than taken from the XrmFramework package, which a WebResources
            project deliberately does not reference — doing so would drag the Dataverse client into
            a web project for four files of JSON. Both packages are built from these same sources
            and released under one version, so the two copies cannot skew.
        -->
        <file src="..\XrmFramework\Definitions\**\*.table" target="build\netstandard2.0\tables\" />

        <file src="lib\**" target="lib" />

    </files>
</package>
