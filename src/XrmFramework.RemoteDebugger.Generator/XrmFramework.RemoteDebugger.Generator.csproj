<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Roslyn source generator configuration -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Ne pas inclure la sortie de build dans le package NuGet lui-même,
         l'assembly est référencé comme analyzer/generator -->
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>XrmFramework.RemoteDebugger.Generator</PackageId>
    <Description>
      Roslyn source generator pour XrmFramework RemoteDebugger.
      Lit les fichiers .pluginsession.json enregistrés lors des sessions de débogage distant
      et génère automatiquement les méthodes de tests unitaires xUnit avec Verify.
    </Description>

    <AssemblyOriginatorKeyFile>$(XrmFramework_KeyFile)</AssemblyOriginatorKeyFile>
    <SignAssembly>$(XrmFramework_EnableStrongNameSigning)</SignAssembly>

      <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
