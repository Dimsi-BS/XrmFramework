<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>XrmFramework.Azure.Functions.Worker.Extensions</id>
    <version>$version$</version>
    <title>XrmFramework.Azure.Functions.Worker.Extensions</title>
    <authors>$author$</authors>
    <owners>$owner$</owners>
    <description>XrmFramework aims at simplifying Microsoft Dynamics 365 and Dataverse plugin, workflows development, deployment and testing</description>
    <summary>XrmFramework aims at simplifying Microsoft Dynamics 365 and Dataverse plugin, workflows development, deployment and testing</summary>
    <language>en-US</language>
    <projectUrl>https://aka.ms/XrmFramework</projectUrl>
    <license type="expression">MIT</license>
    <tags>Dynamics365 CRM DynamicsCrm Dataverse PowerApps</tags>
    <copyright>$copyrigth$</copyright>
    <dependencies>
        <group targetFramework="net8.0">
            <dependency id="Microsoft.Azure.Functions.Worker" version="2.0.0" />
            <dependency id="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" version="2.0.0" />
            <dependency id="Microsoft.Azure.Functions.Worker.Extensions.OpenApi" version="1.5.1" />
            <dependency id="Microsoft.Azure.Functions.Worker.Sdk" version="2.0.0" />
            <dependency id="Functions.Worker.Extensions.HttpApi" version="3.0.0" />
            <dependency id="MediatR" version="12.4.1" />
            <dependency id="MediatR.Extensions.FluentValidation.AspNetCore" version="5.1.0" />
            <dependency id="Newtonsoft.Json" version="13.0.3" />
        </group>
    </dependencies>
  </metadata>

  <files>
      <file src="bin\$config$\net8.0\XrmFramework.Azure.Functions.Worker.Extensions.*" target="lib\net8.0" />

      <file src="build\**\*" target="build/" />

      <file src="$SolutionDir$\*.txt" target="" />
  </files>
</package>
