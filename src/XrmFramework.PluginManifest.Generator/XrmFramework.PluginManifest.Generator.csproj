<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Composant Roslyn (source generator) -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- L'assembly est consommée comme analyzer, pas comme lib -->
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!-- Pas de package autonome : la DLL analyzer est embarquée dans le package
         XrmFramework.Plugin (analyzers/dotnet/cs), référencé par tous les projets plugin. -->
    <IsPackable>false</IsPackable>

    <AssemblyOriginatorKeyFile>$(XrmFramework_KeyFile)</AssemblyOriginatorKeyFile>
    <SignAssembly>$(XrmFramework_EnableStrongNameSigning)</SignAssembly>

    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008 : suivi des releases d'analyzer non requis pour ce générateur interne -->
    <NoWarn>$(NoWarn);1591;RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
