<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Projet exécutable pour le tool xrmframework-tablesync.
      Ce projet N'EST PAS packagé de manière autonome : son binaire est
      embarqué dans XrmFramework.DeployUtils.nupkg sous tools/net8.0/any/.
      Les dotnet tools exigent un TFM unique — on cible net8.0 (LTS actuel).
    -->
    <TargetFramework>net8.0</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XrmFramework.DeployUtils\XrmFramework.DeployUtils.csproj" />
  </ItemGroup>

</Project>
