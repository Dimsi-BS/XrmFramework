<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>XrmFramework.Analyzers.CodeFixes</AssemblyName>

    <!-- Roslyn component: DLL must not be compiled into consuming assemblies -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!--
      This project produces the XrmFramework.Analyzers package, even though it is not the analyzer
      project. It references the analyzer for DiagnosticIds, so it builds last, and only its output
      directory holds both assemblies; packing from the analyzer project ran too early and shipped
      no code fix at all. The reverse reference would be a cycle. See the nuspec next to this file.

      No PackageId is set: giving this project the id of an existing project makes NuGet restore
      fail with "Ambiguous project name". The package identity comes from the nuspec's own <id>.
    -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <NuspecFile>$(MSBuildThisFileDirectory)XrmFramework.Analyzers.nuspec</NuspecFile>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- CodeFix providers intentionally reference Workspaces — do not enforce RS1038 here -->
    <EnforceExtendedAnalyzerRules>false</EnforceExtendedAnalyzerRules>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference Analyzers for DiagnosticIds and shared types (compile-only, not propagated) -->
    <ProjectReference Include="..\XrmFramework.Analyzers\XrmFramework.Analyzers.csproj"
                      ReferenceOutputAssembly="true"
                      OutputItemType="none" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
  </ItemGroup>

</Project>
