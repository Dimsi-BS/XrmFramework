<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>XrmFramework.Analyzers</id>
    <version>$version$</version>
    <title>XrmFramework.Analyzers</title>
    <authors>$author$</authors>
    <owners>$owner$</owners>
    <description>XrmFramework aims at simplifying Microsoft Dynamics 365 and Dataverse plugin, workflows development, deployment and testing</description>
    <summary>XrmFramework aims at simplifying Microsoft Dynamics 365 and Dataverse plugin, workflows development, deployment and testing</summary>
    <language>en-US</language>
    <projectUrl>https://aka.ms/XrmFramework</projectUrl>
    <license type="expression">MIT</license>
    <tags>Dynamics365 CRM DynamicsCrm Dataverse PowerApps</tags>
    <copyright>$copyright$</copyright>
  </metadata>

  <files>
    <!--
      Packed from XrmFramework.Analyzers.CodeFixes, not from XrmFramework.Analyzers. The code fix
      project references the analyzer project for DiagnosticIds, so it builds last, and its output
      directory is the only place where both assemblies sit side by side. Packing from the analyzer
      project ran before the code fixes were compiled, which is how they went missing from the
      package: Roslyn reported the diagnostics and offered no fix for any of them.

      The files are listed one by one on purpose. The wildcard that stood here also swept in the
      .pdb and the .deps.json, and a deps.json in the analyzer folder is at best useless to the
      hosts that load it.
    -->
    <file src="bin\$config$\netstandard2.0\XrmFramework.Analyzers.dll" target="analyzers\dotnet\cs" />
    <file src="bin\$config$\netstandard2.0\XrmFramework.Analyzers.CodeFixes.dll" target="analyzers\dotnet\cs" />

    <!-- Resolved by DependencyLoader; also embedded in the analyzer itself for dev builds. -->
    <file src="bin\$config$\netstandard2.0\Newtonsoft.Json.dll" target="analyzers\dotnet\cs" />
  </files>
</package>
