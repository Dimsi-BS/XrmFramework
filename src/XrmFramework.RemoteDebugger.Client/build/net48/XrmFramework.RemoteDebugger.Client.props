<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">


  <ItemGroup>
    <None Include="$(RootFolder)/Config/App.config">
      <Link>App.config</Link>
      <SubType>Designer</SubType>
    </None>
    <!--
      connectionStrings.config alone is conditioned on being there: it holds credentials, so it is
      gitignored and absent from a fresh clone and from a CI agent, and an unconditional item fails
      the build with MSB3030 over a file the project may never read. A runner that does need it
      still fails at the point of use, where the configSource in App.config names the missing file.
      App.config and xrmFramework.config are versioned, so they stay mandatory.
    -->
    <None Include="$(RootFolder)/Config/connectionStrings.config" Condition="Exists('$(RootFolder)/Config/connectionStrings.config')">
      <Link>connectionStrings.config</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Content Include="$(RootFolder)/Config/xrmFramework.config">
      <Link>xrmFramework.config</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>