<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>

    <!-- Uncomment to deploy as a Dataverse plugin package, which is what lets this project use a
         third-party library: the build then produces a NuGet package carrying the assembly and
         its dependencies, and stamps the assembly so the deployment picks package mode on its
         own - nothing to declare in Config/xrmFramework.config.
         Rules out custom workflow activities and on-premise.
         See https://github.com/Dimsi-BS/XrmFramework/blob/main/docs/Plugins.md#using-a-third-party-library -->
    <!-- <XrmFrameworkPluginPackage>true</XrmFrameworkPluginPackage> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XrmFramework" />
    <PackageReference Include="XrmFramework.Plugin" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(RootFolder)/$(XrmFrameworkCoreProjectName)/**/*.cs" Exclude="$(SolutionDir)/$(XrmFrameworkCoreProjectName)/obj/**;$(SolutionDir)/$(XrmFrameworkCoreProjectName)/bin/**" Link="__Imports/$(XrmFrameworkCoreProjectName)/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  
</Project>
