<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>

    <!-- Uncomment to deploy as a Dataverse plugin package, which is what lets this project use a
         third-party library: the build then produces a NuGet package carrying the assembly and
         its dependencies. Also set deployment="Package" on this project in
         Config/xrmFramework.config. Rules out custom workflow activities and on-premise.
         See https://github.com/Dimsi-BS/XrmFramework/blob/main/docs/Plugins.md#using-a-third-party-library -->
    <!-- <XrmFrameworkPluginPackage>true</XrmFrameworkPluginPackage> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XrmFramework" />
    <PackageReference Include="XrmFramework.Plugin" />

    <!-- Required when XrmFrameworkPluginPackage above is turned on: a plugin package carries the
         real Newtonsoft.Json assembly, where a lone plugin assembly has XrmFramework's vendored
         Newtonsoft source compiled into it instead. Uncomment both lines together - the build
         fails with a message naming the fix if only one of them is. -->
    <!-- <PackageReference Include="Newtonsoft.Json" /> -->
  </ItemGroup>
  
</Project>
