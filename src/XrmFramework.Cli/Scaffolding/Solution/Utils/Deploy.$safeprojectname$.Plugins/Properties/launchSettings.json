{
  "profiles": {
    "Deploy.$safeprojectname$.Plugins": {
      "commandName": "Project"
    },
    "xrmframework CLI (global tool)": {
      "commandName": "Executable",
      "executablePath": "xrmframework",
      "commandLineArgs": "deploy plugins --dll \"bin/Debug/net48/$safeprojectname$.Plugins.dll\" --project $safeprojectname$.Plugins --project-root ../..",
      "workingDirectory": "."
    },
    "xrmframework CLI (local tool)": {
      "commandName": "Executable",
      "executablePath": "dotnet",
      "commandLineArgs": "xrmframework deploy plugins --dll \"bin/Debug/net48/$safeprojectname$.Plugins.dll\" --project $safeprojectname$.Plugins --project-root ../..",
      "workingDirectory": "."
    }
  }
}
