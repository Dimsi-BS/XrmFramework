<?xml version="1.0" encoding="utf-8"?>
<xrmFramework selectedConnection="Xrm">
  <entitySolution name="EntitySolutionUniqueName" />
  <projects>
    <!--
      deployment="assembly" (the default) pushes the signed assembly on its own.
      deployment="package" pushes a NuGet package carrying the assembly AND its dependencies,
      which is the only way to use a third-party library in a plugin. It also requires
      <XrmFrameworkPluginPackage>true</XrmFrameworkPluginPackage> in the project, and rules out
      custom workflow activities and on-premise environments.
    -->
    <add name="$safeprojectname$.Plugins" targetSolution="PluginsSolutionUniqueName" type="PluginsWorkflows" deployment="assembly" />
  </projects>
</xrmFramework>
