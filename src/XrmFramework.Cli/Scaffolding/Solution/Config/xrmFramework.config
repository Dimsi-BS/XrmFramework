<?xml version="1.0" encoding="utf-8"?>
<xrmFramework selectedConnection="Xrm">
  <entitySolution name="EntitySolutionUniqueName" />
  <projects>
    <!--
      deployment is optional and defaults to "Auto": the deployment follows what the build
      produced, so turning XrmFrameworkPluginPackage on in the plugin project is enough and there
      is nothing to change here. The summary printed before the connection says which shape was
      detected and why.

      Set it explicitly to pin the choice - "Assembly" to push the signed assembly on its own,
      "Package" to push a NuGet package carrying the assembly AND its dependencies, which is the
      only way to use a third-party library in a plugin. An explicit value always wins, and
      "Package" rules out custom workflow activities and on-premise environments.
    -->
    <add name="$safeprojectname$.Plugins" targetSolution="PluginsSolutionUniqueName" type="PluginsWorkflows" />
  </projects>
</xrmFramework>
