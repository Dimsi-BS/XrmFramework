<Project Sdk="Microsoft.NET.Sdk">

  <!--
    XrmFramework CLI distributed as a .NET tool (dotnet tool install).
    Spectre.Console.Cli facade on top of the logic hosted in
    XrmFramework.DeployUtils (TableSyncHelper, DefinitionAnalyzer, TableFileSyncer,
    DefinitionFileMigrator).

    Installation:  dotnet tool install XrmFramework.Cli (globally or locally)
    Invocation  :  xrmframework migrate sync-tables (dll / tables-dir / clean options)
                   -> one-shot migration of the definitions from 2.* to 3.1+
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET tools require a single TFM — targeting net10.0 (current LTS). -->
    <TargetFramework>net10.0</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Packaging as a .NET tool: PackAsTool sets PackageType=DotnetTool
         and places the output (closure included) under tools/net10.0/any/. -->
    <PackageId>XrmFramework.Cli</PackageId>
    <IsPackable>true</IsPackable>
    <!-- The pipeline (NugetPackages-Azure.yml) only runs "dotnet build": without this property
         the CLI's .nupkg is never generated nor copied into GeneratedNuGetPackages. -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xrmframework</ToolCommandName>
    <PackageDescription>XrmFramework CLI: Dynamics 365 / Dataverse development and deployment utilities, including the migration of definitions from XrmFramework 2.* to 3.1+.</PackageDescription>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XrmFramework.DeployUtils\XrmFramework.DeployUtils.csproj" />

    <!--
      net462 inventory tool: referenced only for build ordering (no code dependency;
      the CLI launches it out-of-process). SkipGetTargetFrameworkProperties avoids the TFM
      negotiation between net8 and net462.
    -->
    <ProjectReference Include="..\XrmFramework.PluginInventory\XrmFramework.PluginInventory.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>

  <!--
    Embeds the net462 inventory exe under inventory/: copied next to the tool (resolved via
    AppContext.BaseDirectory). PackAsTool packages the publish output under
    tools/net10.0/any/, so CopyToOutputDirectory is enough — an explicit Pack inclusion
    would create a duplicate (NU5118).
    The helper has no third-party dependency (BCL + framework GAC) -> only the exe is needed.
  -->
  <ItemGroup>
    <None Include="..\XrmFramework.PluginInventory\bin\$(Configuration)\net462\XrmFramework.PluginInventory.exe"
          Link="inventory\XrmFramework.PluginInventory.exe"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <!--
    Scaffolding content for "xrmframework new" (SolutionScaffolder and friends in DeployUtils):
    the former XrmFramework.Templates dotnet-new template trees, minus their .template.config and
    initXrm.ps1 (the scaffolder replaces both — token substitution and the postAction logic are now
    plain C#). Already under the project directory, so the SDK's implicit glob already declares
    these as None items; Update (not Include) just adds CopyToOutputDirectory without duplicating
    them. PackAsTool packages the whole publish output under tools/net10.0/any/, so this is enough
    for the content to ship in the .nupkg too.
  -->
  <ItemGroup>
    <!-- The scaffolding content is data, not code: excluded from every implicit glob (its .cs
         files would otherwise be compiled straight into the CLI, and its nested .csproj files
         are just text as far as this project is concerned) and re-declared as plain None. -->
    <Compile Remove="Scaffolding\**" />
    <EmbeddedResource Remove="Scaffolding\**" />
    <None Remove="Scaffolding\**" />
    <None Include="Scaffolding\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <!-- "tables edit" full-screen editor. Confined to the Cli tool (single net10.0 TFM) rather
         than XrmFramework.DeployUtils: that package also multi-targets net462 for deployment
         utilities, none of which need a TUI, and Terminal.Gui only ships net8.0+ assets. -->
    <PackageReference Include="Terminal.Gui" />
  </ItemGroup>

</Project>
