<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CLI XrmFramework distribué comme .NET tool (dotnet tool install).
    Façade Spectre.Console.Cli au-dessus de la logique hébergée dans
    XrmFramework.DeployUtils (TableSyncHelper, DefinitionAnalyzer, TableFileSyncer).

    Installation :  dotnet tool install XrmFramework.Cli (en global ou en local)
    Invocation   :  xrmframework tables sync (options dll / tables-dir / clean)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Les .NET tools exigent un TFM unique — on cible net10.0 (LTS courant). -->
    <TargetFramework>net10.0</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Packaging en tant que .NET tool : PackAsTool règle PackageType=DotnetTool
         et range la sortie (closure incluse) sous tools/net10.0/any/. -->
    <PackageId>XrmFramework.Cli</PackageId>
    <IsPackable>true</IsPackable>
    <!-- La pipeline (NugetPackages-Azure.yml) ne fait que « dotnet build » : sans cette propriété
         le .nupkg du CLI n'est jamais généré ni recopié dans GeneratedNuGetPackages. -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xrmframework</ToolCommandName>
    <PackageDescription>CLI XrmFramework : synchronisation des fichiers .table et utilitaires de développement Dynamics 365 / Dataverse.</PackageDescription>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XrmFramework.DeployUtils\XrmFramework.DeployUtils.csproj" />

    <!--
      Outil d'inventaire net462 : référencé uniquement pour l'ordre de build (pas de dépendance de
      code ; le CLI le lance hors-process). SkipGetTargetFrameworkProperties évite la négociation
      de TFM net8 ↔ net462.
    -->
    <ProjectReference Include="..\XrmFramework.PluginInventory\XrmFramework.PluginInventory.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>

  <!--
    Embarque l'exe d'inventaire net462 sous inventory/ : copié à côté du tool (résolu via
    AppContext.BaseDirectory). PackAsTool empaquette la sortie de publication sous
    tools/net10.0/any/, donc CopyToOutputDirectory suffit — une inclusion Pack explicite
    ferait doublon (NU5118).
    Le helper n'a aucune dépendance tierce (BCL + framework GAC) → seul l'exe est nécessaire.
  -->
  <ItemGroup>
    <None Include="..\XrmFramework.PluginInventory\bin\$(Configuration)\net462\XrmFramework.PluginInventory.exe"
          Link="inventory\XrmFramework.PluginInventory.exe"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

</Project>
