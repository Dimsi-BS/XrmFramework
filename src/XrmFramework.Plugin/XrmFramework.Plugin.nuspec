<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>XrmFramework.Plugin</id>
    <version>$version$</version>
    <title>XrmFramework.Plugin</title>
    <authors>$author$</authors>
    <owners>$owner$</owners>
    <description>XrmFramework aims at simplifying Microsoft Dynamics 365  and Dataverse plugin, workflows development, deployment and testing</description>
    <summary>XrmFramework aims at simplifying Microsoft Dynamics 365 and Dataverse plugin, workflows development, deployment and testing</summary>
    <language>en-US</language>
    <projectUrl>https://aka.ms/XrmFramework</projectUrl>
    <license type="expression">MIT</license>
    <tags>Dynamics365 CRM DynamicsCrm Dataverse PowerApps</tags>
    <copyright>$copyright$</copyright>
    <dependencies>
      <group targetFramework="net462">
        <dependency id="XrmFramework" version="[$version$]" />
      </group>
      <group targetFramework="net48">
        <dependency id="XrmFramework" version="[$version$]" />
      </group>
    </dependencies>
  </metadata>

  <files>
    <!-- contentFiles are compiled into the consuming project automatically. The vendored
         Newtonsoft.Json source is deliberately kept OUT of them (see the exclude below) and
         shipped under build/ instead, where nothing is auto-compiled: XrmFramework.Plugin.targets
         adds it as Compile only for a project deployed as a plain assembly. A project deployed as
         a plugin package references the real Newtonsoft.Json package instead, and compiling the
         source there too would duplicate every type in the Newtonsoft.Json namespace. -->
    <file src="**\*.cs" target="contentFiles/cs/any/__Imports/XrmFramework.Plugin" exclude="obj\**;**\AssemblyInfos.cs;NewtonSoft.Json\**" />
    <file src="NewtonSoft.Json\**\*.cs" target="build/NewtonSoft.Json" />
    <file src="build\**\*" target="build/" />

    <file src="lib\**" target="lib" />
  </files>
</package>
