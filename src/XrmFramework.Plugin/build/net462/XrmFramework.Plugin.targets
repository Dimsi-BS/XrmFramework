<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Plugin package (dependent assemblies) packaging, opt-in via XrmFrameworkPluginPackage. -->
  <Import Project="$(MSBuildThisFileDirectory)../Shared/XrmFramework.Plugin.Package.targets" />

  <!-- `dotnet build -t:XrmFrameworkDeploy`: deployment through the XrmFramework CLI. -->
  <Import Project="$(MSBuildThisFileDirectory)../Shared/XrmFramework.Plugin.Deploy.targets" />

</Project>
