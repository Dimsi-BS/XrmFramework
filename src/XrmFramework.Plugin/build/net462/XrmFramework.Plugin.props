<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);DISABLE_DI;PLUGIN</DefineConstants>

  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Activities">
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(RootFolder)\$(XrmFrameworkCoreProjectName)\**\*.cs" Exclude="$(RootFolder)\$(XrmFrameworkCoreProjectName)\obj\**;$(RootFolder)\$(XrmFrameworkCoreProjectName)\bin\**" Link="__Imports\$(XrmFrameworkCoreProjectName)\%(RecursiveDir)%(Filename)%(Extension)" />
      <AdditionalFiles Include="$(RootFolder)\$(XrmFrameworkCoreProjectName)\**\*.table" Exclude="$(RootFolder)\$(XrmFrameworkCoreProjectName)\obj\**;$(RootFolder)\$(XrmFrameworkCoreProjectName)\bin\**" Link="__Imports\$(XrmFrameworkCoreProjectName)\%(RecursiveDir)%(Filename)%(Extension)" />
      <AdditionalFiles Include="$(RootFolder)\$(XrmFrameworkCoreProjectName)\**\*.model" Exclude="$(RootFolder)\$(XrmFrameworkCoreProjectName)\obj\**;$(RootFolder)\$(XrmFrameworkCoreProjectName)\bin\**" Link="__Imports\$(XrmFrameworkCoreProjectName)\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RootFolder)\$(XrmFrameworkCoreProjectName)\$(XrmFrameworkCoreProjectName).csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

    <PropertyGroup>
        <DefineConstants>$(DefineConstants);PLUGIN</DefineConstants>
    </PropertyGroup>
</Project>
