<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net462 inventory tool, launched out-of-process by the net8 CLI (deploy plugins command).
    It loads the plugin assembly, EXECUTES the constructors (AddSteps) and reflects over the types
    to produce the JSON manifest (plugins/steps/workflows/custom APIs) on standard output.

    net462 is mandatory: instantiating a plugin executes code that depends on Microsoft.Xrm.Sdk
    (net462) — impossible from a net8 process. Deliberately self-contained (no reference to the
    rest of the solution) so it stays packageable in the net8 tool with a minimal closure.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>XrmFramework.PluginInventory</AssemblyName>
    <RootNamespace>XrmFramework.PluginInventory</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Embedded in the CLI package, not published as a standalone package. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <SignAssembly>$(XrmFramework_EnableStrongNameSigning)</SignAssembly>
    <AssemblyOriginatorKeyFile>$(XrmFramework_KeyFile)</AssemblyOriginatorKeyFile>
  </PropertyGroup>

</Project>
