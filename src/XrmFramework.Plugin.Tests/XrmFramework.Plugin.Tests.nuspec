<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>XrmFramework.Plugin.Tests</id>
    <version>$version$</version>
    <title>XrmFramework.Plugin.Tests</title>
    <authors>$author$</authors>
    <owners>$owner$</owners>
    <description>
      Unit test sources for XrmFramework.Plugin.
      Reference this package in your test project to compile the Framework's tests
      directly into your assembly and measure the Framework's own code coverage.
      The .cs files are embedded as contentFiles (buildAction=Compile):
      they are added to the consuming project's compilation without an extra DLL.
    </description>
    <summary>Unit test sources for XrmFramework.Plugin — enables code coverage measurement of the framework itself.</summary>
    <language>en-US</language>
    <projectUrl>https://aka.ms/XrmFramework</projectUrl>
    <license type="expression">MIT</license>
    <tags>Dynamics365 CRM DynamicsCrm Dataverse PowerApps Tests Coverage</tags>
    <copyright>$copyright$</copyright>
    <!--
      developmentDependency=true: this package is a development-only dependency.
      It will not be propagated as a transitive dependency if the consumer publishes their own package.
    -->
    <developmentDependency>true</developmentDependency>

    <!--
      Explicit buildAction declaration so that NuGet treats all .cs files
      as <Compile> items in the consuming project (SDK-style and packages.config).
    -->
    <contentFiles>
      <files include="**/*.cs" buildAction="Compile" />
    </contentFiles>

    <dependencies>
      <group targetFramework="net462">
        <!-- Version pinned to the package's own version: the tests must match the Framework exactly -->
        <dependency id="XrmFramework.Plugin" version="[$version$]" />
        <!-- NUnit test infrastructure -->
        <dependency id="Microsoft.NET.Test.Sdk" version="$Ver_NETTestSdk$" />
        <!-- NUnit 4.5.1: minimum version declared for consumer compatibility. -->
        <dependency id="NUnit"                  version="4.5.1" />
        <dependency id="NUnit3TestAdapter"       version="$Ver_NUnit3Adapter$" />
        <!--
          coverlet.collector is managed via the build/net462/XrmFramework.Plugin.Tests.props file
          with PrivateAssets=all to avoid transitive propagation.
        -->
      </group>
    </dependencies>
  </metadata>

  <files>
    <!--
      Test sources embedded as contentFiles.
      Target: contentFiles/cs/any/__Tests/XrmFramework.Plugin.Tests/
      NuGet will add them as <Compile> in the consuming project,
      alongside the Framework's own sources (contentFiles from XrmFramework.Plugin).
      Code coverage will therefore cover both sets of sources.
    -->
    <file src="..\Tests\XrmFramework.Plugin.Tests\**\*.cs"
          target="contentFiles\cs\any\__Tests\XrmFramework.Plugin.Tests"
          exclude="..\Tests\XrmFramework.Plugin.Tests\obj\**;..\Tests\XrmFramework.Plugin.Tests\bin\**;**\AssemblyInfos.cs" />

    <!--
      Placeholder lib: source-only package, no compiled assembly provided.
      The _._  file tells NuGet that net462 is supported without a DLL.
    -->
    <file src="lib\net462\_._" target="lib\net462" />

    <!--
      .props file injected by NuGet into the consuming project:
      adds coverlet.collector with PrivateAssets=all.
    -->
    <file src="build\**\*" target="build" />
  </files>
</package>
