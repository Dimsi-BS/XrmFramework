<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Source project for the XrmFramework.Plugin.Tests NuGet package.

    This project serves two purposes:
      1. Compile the test sources to verify that they build correctly
         against the current version of XrmFramework.Plugin.
      2. Generate the NuGet package that embeds these sources as contentFiles,
         allowing consumers to measure the Framework's code coverage.

    IMPORTANT: This project is NOT a test runner (IsTestProject=false).
    To run the tests locally, use src/Tests/XrmFramework.Plugin.Tests/.
  -->

  <PropertyGroup>
    <TargetFrameworks>net462</TargetFrameworks>
    <AssemblyName>XrmFramework.Plugin.Tests</AssemblyName>
    <AssemblyOriginatorKeyFile>$(XrmFramework_KeyFile)</AssemblyOriginatorKeyFile>
    <SignAssembly>$(XrmFramework_EnableStrongNameSigning)</SignAssembly>

    <!-- Packaging -->
    <PackageId>XrmFramework.Plugin.Tests</PackageId>
    <NuspecFile>$(MSBuildThisFileDirectory)XrmFramework.Plugin.Tests.nuspec</NuspecFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!--
      This project compiles the tests for validation purposes, but is not a runnable test project.
      The test runner is src/Tests/XrmFramework.Plugin.Tests/.
    -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <!--
    Reference to the Framework project for local compilation.
    When the NuGet package is consumed, this reference is replaced
    by the dependency declared in the .nuspec (XrmFramework.Plugin).
  -->
  <ItemGroup>
    <ProjectReference Include="..\XrmFramework.Plugin\XrmFramework.Plugin.csproj" />
  </ItemGroup>

  <!--
    NUnit dependencies required to compile the test sources.
    PrivateAssets=all on the SDK and the adapter: they must not appear
    in the generated package's transitive dependencies (handled via nuspec).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit" />
  </ItemGroup>

  <!--
    Test sources linked from src/Tests/XrmFramework.Plugin.Tests/.
    Single source of truth: the files are not duplicated.
    The Link= attribute controls how they are displayed in the IDE.
  -->
  <ItemGroup>
    <Compile Include="..\Tests\XrmFramework.Plugin.Tests\**\*.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)"
             Exclude="..\Tests\XrmFramework.Plugin.Tests\obj\**;..\Tests\XrmFramework.Plugin.Tests\bin\**" />
  </ItemGroup>

</Project>
