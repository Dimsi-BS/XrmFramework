<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>XrmFramework.Tests</id>
    <version>$version$</version>
    <title>XrmFramework.Tests</title>
    <authors>$author$</authors>
    <owners>$owner$</owners>
    <description>
      Unit test sources for XrmFramework.
      Reference this package in your test project to compile the Framework's tests
      directly into your assembly and measure code coverage of the Framework itself.
      The .cs files are embedded as contentFiles (buildAction=Compile):
      they are added to the consuming project's compilation without an extra DLL.
    </description>
    <summary>Unit test sources for XrmFramework — enables code coverage measurement of the framework itself.</summary>
    <language>en-US</language>
    <projectUrl>https://aka.ms/XrmFramework</projectUrl>
    <license type="expression">MIT</license>
    <tags>Dynamics365 CRM DynamicsCrm Dataverse PowerApps Tests Coverage</tags>
    <copyright>$copyright$</copyright>
    <!--
      developmentDependency=true: this package is a development-only dependency.
      It will not be propagated as a transitive dependency if the consumer publishes their own package.
    -->
    <developmentDependency>true</developmentDependency>

    <!--
      Explicit buildAction declaration so NuGet treats all .cs files
      as <Compile> items in the consuming project.
    -->
    <contentFiles>
      <files include="**/*.cs" buildAction="Compile" />
    </contentFiles>

    <dependencies>
      <group targetFramework="net462">
        <dependency id="Microsoft.NET.Test.Sdk" version="$Ver_NETTestSdk$" />
        <dependency id="NUnit"                  version="$Ver_NUnit$" />
        <dependency id="NUnit3TestAdapter"       version="$Ver_NUnit3Adapter$" />
        <dependency id="Moq"                    version="$Ver_Moq$" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Microsoft.NET.Test.Sdk" version="$Ver_NETTestSdk$" />
        <dependency id="NUnit"                  version="$Ver_NUnit$" />
        <dependency id="NUnit3TestAdapter"       version="$Ver_NUnit3Adapter$" />
        <dependency id="Moq"                    version="$Ver_Moq$" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="Microsoft.NET.Test.Sdk" version="$Ver_NETTestSdk$" />
        <dependency id="NUnit"                  version="$Ver_NUnit$" />
        <dependency id="NUnit3TestAdapter"       version="$Ver_NUnit3Adapter$" />
        <dependency id="Moq"                    version="$Ver_Moq$" />
      </group>
    </dependencies>
  </metadata>

  <files>
    <!--
      Test sources embedded as contentFiles.
      Target: contentFiles/cs/any/__Tests/XrmFramework.Tests/
      NuGet will add them as <Compile> in the consuming project.
      Code coverage will therefore cover the Framework's own sources.
    -->
    <file src="**\*.cs"
          target="contentFiles\cs\any\__Tests\XrmFramework.Tests"
          exclude="obj\**;bin\**;**\AssemblyInfo.cs" />

    <!--
      Lib placeholders: source-only package, no compiled assembly provided.
    -->
    <file src="lib\net462\_._" target="lib\net462" />
    <file src="lib\net8.0\_._"  target="lib\net8.0" />
    <file src="lib\net10.0\_._" target="lib\net10.0" />

    <!--
      .props files injected by NuGet into the consuming project:
      add coverlet.collector with PrivateAssets=all.
    -->
    <file src="build\**\*" target="build" />
  </files>
</package>
