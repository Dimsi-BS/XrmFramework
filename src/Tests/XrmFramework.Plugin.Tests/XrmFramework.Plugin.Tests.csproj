<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\XrmFramework.Plugin\XrmFramework.Plugin.csproj" />
  </ItemGroup>


  <!--
    Sources de tests liées depuis src/Tests/XrmFramework.Tests/.
    Source unique de vérité : les fichiers ne sont pas dupliqués.
    Le Link= contrôle l'affichage dans l'IDE.
  -->
  <ItemGroup>
    <Compile Include="..\XrmFramework.Tests\**\*.cs"
             Link="_Tests/%(RecursiveDir)%(Filename)%(Extension)"
             Exclude="..\XrmFramework.Tests\obj\**;..\XrmFramework.Tests\bin\**" />
  </ItemGroup>


    <PropertyGroup>
        <CollectCoverage>true</CollectCoverage>
        <Exclude>[Newtonsoft.Json]*</Exclude>
        <ExcludeByFile>**/Bodi.cs</ExcludeByFile>
    </PropertyGroup>


</Project>
