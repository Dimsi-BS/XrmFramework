<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <AssemblyOriginatorKeyFile>$(XrmFramework_KeyFile)</AssemblyOriginatorKeyFile>
    <SignAssembly>$(XrmFramework_EnableStrongNameSigning)</SignAssembly>
    <PublicSign>$(XrmFramework_PublicSign)</PublicSign>

    <!--
      CS0436: the .table files below are regenerated here while the XrmFramework assembly this
      project references already carries the same definitions, so every *Definition class exists
      twice and the local one wins. Harmless — both come from the same .table — and not specific
      to this project: the shipped props re-add the package's tables to every consuming project,
      which references an assembly that contains them too.
    -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- Raises the transitive floor of System.Private.DataContractSerialization 4.3.0
         (Dataverse.Client chain) — CVE-2019-0820 (High), fixed in 4.3.1. -->
    <PackageReference Include="System.Text.RegularExpressions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\XrmFramework\XrmFramework.csproj" />
  </ItemGroup>

  <!--
    Runs the generators over real .table files and the .model files beside them, so the binding
    models they produce have to compile. The unit tests over the generators assert on emitted
    text; only an actual compilation proves that text is valid C#.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\XrmFramework.Analyzers\XrmFramework.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\XrmFramework\Definitions\**\*.table"
                     Link="_Imports\%(RecursiveDir)%(Filename)%(Extension)" />
    <AdditionalFiles Include="Models\**\*.model" />
    <None Include="Models\**\*.model" />
  </ItemGroup>

</Project>
