<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests du moteur d'inventaire (XrmFramework.PluginInventory) sur net8.0.

    Le moteur est de la réflexion pure (agnostique au TFM) : on en lie les sources et on l'exécute
    contre des plugins « stub » net8 qui miment la forme XrmFramework. On réutilise les vrais types
    cœur (Stages/Modes/Messages, fournis par DeployUtils) et le vrai PluginManifestReader pour
    valider le round-trip producteur → consommateur.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>

    <AssemblyOriginatorKeyFile>$(XrmFramework_KeyFile)</AssemblyOriginatorKeyFile>
    <SignAssembly>$(XrmFramework_EnableStrongNameSigning)</SignAssembly>
    <PublicSign>$(XrmFramework_PublicSign)</PublicSign>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" VersionOverride="18.4.0" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- Remonte le plancher transitif de System.Private.DataContractSerialization 4.3.0
         (chaîne Dataverse.Client) — CVE-2019-0820 (High), corrigé en 4.3.1. -->
    <PackageReference Include="System.Text.RegularExpressions" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\XrmFramework.DeployUtils\XrmFramework.DeployUtils.csproj" />
  </ItemGroup>

  <!-- Moteur d'inventaire lié en source (compilé pour net8 dans cet assembly de test). -->
  <ItemGroup>
    <Compile Include="..\..\XrmFramework.PluginInventory\PluginInventoryEngine.cs" Link="_Engine\PluginInventoryEngine.cs" />
    <Compile Include="..\..\XrmFramework.PluginInventory\ManifestModel.cs" Link="_Engine\ManifestModel.cs" />
  </ItemGroup>

</Project>
