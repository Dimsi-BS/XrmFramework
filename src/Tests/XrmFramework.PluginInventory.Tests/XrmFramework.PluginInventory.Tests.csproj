<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the inventory engine (XrmFramework.PluginInventory) on net8.0.

    The engine is pure reflection (TFM-agnostic): its sources are linked in and run against net8
    "stub" plugins that mimic the XrmFramework shape. We reuse the real core types (Stages/Modes/
    Messages, provided by DeployUtils) and the real PluginManifestReader to validate the
    producer → consumer round-trip.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>

    <AssemblyOriginatorKeyFile>$(XrmFramework_KeyFile)</AssemblyOriginatorKeyFile>
    <SignAssembly>$(XrmFramework_EnableStrongNameSigning)</SignAssembly>
    <PublicSign>$(XrmFramework_PublicSign)</PublicSign>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" VersionOverride="18.4.0" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- Bumps the transitive floor of System.Private.DataContractSerialization 4.3.0
         (Dataverse.Client chain) — CVE-2019-0820 (High), fixed in 4.3.1. -->
    <PackageReference Include="System.Text.RegularExpressions" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\XrmFramework.DeployUtils\XrmFramework.DeployUtils.csproj" />
  </ItemGroup>

  <!-- Inventory engine linked in source (compiled for net8 in this test assembly). -->
  <ItemGroup>
    <Compile Include="..\..\XrmFramework.PluginInventory\PluginInventoryEngine.cs" Link="_Engine\PluginInventoryEngine.cs" />
    <Compile Include="..\..\XrmFramework.PluginInventory\ManifestModel.cs" Link="_Engine\ManifestModel.cs" />
  </ItemGroup>

</Project>
