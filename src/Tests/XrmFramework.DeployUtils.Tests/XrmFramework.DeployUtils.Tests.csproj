<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <AssemblyOriginatorKeyFile>$(XrmFramework_KeyFile)</AssemblyOriginatorKeyFile>
    <SignAssembly>$(XrmFramework_EnableStrongNameSigning)</SignAssembly>
    <PublicSign>$(XrmFramework_PublicSign)</PublicSign>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" VersionOverride="18.4.0" />
    <PackageReference Include="Moq" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Newtonsoft.Json" />
    <!-- Remonte le plancher transitif de System.Private.DataContractSerialization 4.3.0
         (chaîne Dataverse.Client) — CVE-2019-0820 (High), corrigé en 4.3.1. -->
    <PackageReference Include="System.Text.RegularExpressions" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\XrmFramework.DeployUtils\XrmFramework.DeployUtils.csproj" />
  </ItemGroup>

  <!--
    Sources de tests liées depuis src/Tests/XrmFramework.Tests/.
    Source unique de vérité : les fichiers ne sont pas dupliqués.
    Le Link= contrôle l'affichage dans l'IDE.
  -->
  <ItemGroup>
    <Compile Include="..\XrmFramework.Tests\**\*.cs"
             Link="_Tests/%(RecursiveDir)%(Filename)%(Extension)"
             Exclude="..\XrmFramework.Tests\obj\**;..\XrmFramework.Tests\bin\**" />
  </ItemGroup>
</Project>
