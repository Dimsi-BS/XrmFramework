<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <AssemblyOriginatorKeyFile>$(XrmFramework_KeyFile)</AssemblyOriginatorKeyFile>
    <SignAssembly>$(XrmFramework_EnableStrongNameSigning)</SignAssembly>
    <PublicSign>$(XrmFramework_PublicSign)</PublicSign>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" VersionOverride="18.4.0" />
    <PackageReference Include="Moq" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Newtonsoft.Json" />
    <!-- Raises the transitive floor of System.Private.DataContractSerialization 4.3.0
         (Dataverse.Client chain) — CVE-2019-0820 (High), fixed in 4.3.1. -->
    <PackageReference Include="System.Text.RegularExpressions" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\XrmFramework.DeployUtils\XrmFramework.DeployUtils.csproj" />
  </ItemGroup>

  <!--
    Test sources linked from src/Tests/XrmFramework.Tests/.
    Single source of truth: the files are not duplicated.
    The Link= controls how they are displayed in the IDE.
  -->
  <ItemGroup>
    <Compile Include="..\XrmFramework.Tests\**\*.cs"
             Link="_Tests/%(RecursiveDir)%(Filename)%(Extension)"
             Exclude="..\XrmFramework.Tests\obj\**;..\XrmFramework.Tests\bin\**" />

    <!--
      DeployUtils no longer bundles the framework's runtime layer (Service/, Context/):
      the corresponding tests no longer have a subject here. They still run as part of
      XrmFramework.Tests, against the XrmFramework project itself.
    -->
    <Compile Remove="..\XrmFramework.Tests\Service\**\*.cs" />
    <Compile Remove="..\XrmFramework.Tests\Context\**\*.cs" />
  </ItemGroup>
</Project>
