<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <TargetFrameworks>$(XrmFramework_Runtime_TFM)</TargetFrameworks>
    <AssemblyName>XrmFramework.DeployUtils</AssemblyName>
    <AssemblyOriginatorKeyFile>$(XrmFramework_KeyFile)</AssemblyOriginatorKeyFile>
    <SignAssembly>$(XrmFramework_EnableStrongNameSigning)</SignAssembly>
    <PublicSign>$(XrmFramework_PublicSign)</PublicSign>
    <PackageId>XrmFramework.DeployUtils</PackageId>

    <NuspecFile>$(MSBuildThisFileDirectory)XrmFramework.DeployUtils.nuspec</NuspecFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>


    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>

    <NoWarn>$(NoWarn);1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\XrmFramework\**\*.cs" Link="_Imports\XrmFramework\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\XrmFramework\bin\**;..\XrmFramework\obj\**;..\XrmFramework\Generated\**;" />

        <Compile Include="..\XrmFramework.Core\**\*.cs" Link="_Imports\XrmFramework.Core\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\XrmFramework.Core\bin\**;..\XrmFramework.Core\obj\**" />

        <Compile Include="..\XrmFramework.Plugin\RemoteDebugger\**\*.cs" Link="_Imports\XrmFramework.Plugin\RemoteDebugger\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\XrmFramework.Plugin\**\*partial*.cs;..\XrmFramework.Plugin\RemoteDebugger\RemoteDebugger.Remote\*.cs" />

  
        <Compile Include="..\XrmFramework.Plugin\**\StepConfiguration*.cs" Link="Model\StepConfigurations\%(RecursiveDir)%(Filename)%(Extension)" />


        <Compile Remove="Service\IDeploySettingsProvider.cs" />


        <Compile Remove="Service\ITargetSolutionProvider.cs" />


        <Compile Remove="Service\TargetSolutionProvider.cs" />


    </ItemGroup>

    <!--
      Framework runtime layer (services, execution context, logging):
      it only makes sense within a plugin assembly. No DeployUtils code
      uses it — the generators only handle "IService" / "IServiceContext" as
      strings, in order to emit code on the consumer side.

      Bundling it here re-published XrmFramework.IService and about a hundred other types
      from the XrmFramework namespace already compiled in the consumer's Core project (delivered
      as contentFiles), causing CS0433 errors in projects that reference both.
    -->
    <ItemGroup>
        <Compile Remove="..\XrmFramework\Service\**\*.cs" />
        <Compile Remove="..\XrmFramework\Context\**\*.cs" />
        <Compile Remove="..\XrmFramework\Utils\LogHelper.cs" />
        <Compile Remove="..\XrmFramework\Utils\LoggerFactory.cs" />
        <Compile Remove="..\XrmFramework\Utils\DefaultLoggerWithSettings.cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'" >
        <Compile Include="..\XrmFramework.Workflows\**\*.cs" Link="_Imports\XrmFramework.Workflows\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\XrmFramework.Workflows\EnableRuleProvider\**\*.cs;..\XrmFramework.Workflows\**\CustomWorkflowActivity*.cs;..\XrmFramework.Workflows\obj\**\*.cs;..\XrmFramework.Workflows\RemoteDebugger\RemoteDebugger.Remote\*.cs" />

        <!--
          Same on the workflows side: execution context derives from the layer removed
          above. The Remove must follow the Include, since MSBuild evaluates in file order.
        -->
        <Compile Remove="..\XrmFramework.Workflows\Context\**\*.cs" />
        <Compile Remove="..\XrmFramework.Workflows\RemoteDebugger\LocalWorkflowContext.cs" />
    </ItemGroup>
    
    
    
    <ItemGroup>
        <ProjectReference Include="..\XrmFramework.Analyzers\XrmFramework.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\XrmFramework.Analyzers.CodeFixes\XrmFramework.Analyzers.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="../XrmFramework/**/*.table"  Exclude="../XrmFramework/bin/**;../XrmFramework/obj/**" />
    </ItemGroup>

  <!--
    In-process inventory (net462 only): links the shared engine from
    XrmFramework.PluginInventory. On net8/net10 the inventory goes through the out-of-process net462 exe
    (instantiating a net462 plugin is not possible from net8).
  -->
  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <Compile Include="..\XrmFramework.PluginInventory\PluginInventoryEngine.cs" Link="_Imports\PluginInventory\PluginInventoryEngine.cs" />
    <Compile Include="..\XrmFramework.PluginInventory\ManifestModel.cs" Link="_Imports\PluginInventory\ManifestModel.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <!-- XrmTooling 9.1.1.45 required on net462; central version = 9.1.1.65 (OnPremise) -->
    <PackageReference Include="Microsoft.CrmSdk.XrmTooling.CoreAssembly" VersionOverride="9.1.1.45" />
    <!-- DI 3.1.8 required on net462; central version = 10.0.7 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" VersionOverride="3.1.8" />

    <Reference Include="System.Configuration" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" />
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client.Dynamics" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="CommandLineParser" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>


    <ItemGroup>
        <None Remove="**\*.table" />
        <AdditionalFiles Include="..\XrmFramework\**\*.table" Link="_Imports\XrmFramework\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\XrmFramework\bin/**;..\XrmFramework\obj/**" />

        <AdditionalFiles Include="**\*.table" Exclude="bin/**;obj/**" />
    </ItemGroup>


    <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
      <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" />
      <PackageReference Include="Microsoft.CrmSdk.Workflow" />
    </ItemGroup>

  <!--
    .table file synchronization is now distributed as a standalone .NET tool
    (XrmFramework.Cli project, "xrmframework tables sync" command).
    The logic still lives here (TableSyncHelper / DefinitionAnalyzer / TableFileSyncer).
  -->

</Project>
