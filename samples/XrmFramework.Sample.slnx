<Solution>
  <!--
    Sample solution for XrmFramework.
    References the framework's source PROJECTS (instead of the NuGet packages)
    to allow step-by-step debugging into the framework code.

    Structure:
      /Sample/           → Sample projects (Core + Plugins)
      /Sample/Utils/     → Utility tools (deployment, remote debugging, DefinitionManager)
      /Framework/        → Framework source projects (for navigation and debugging)
  -->

  <!-- ═══════════════════════════════════════════════════
       SAMPLE PROJECTS
       ═══════════════════════════════════════════════════ -->
  <Folder Name="/Sample/">
    <Project Path="XrmFramework.Sample.Core/XrmFramework.Sample.Core.csproj" />
    <Project Path="XrmFramework.Sample.Plugins/XrmFramework.Sample.Plugins.csproj" />
  </Folder>
  <Folder Name="/Sample/Config/">
    <File Path="Config/App.config" />
    <File Path="Config/connectionStrings.config" />
    <File Path="Config/xrmFramework.config" />
  </Folder>

  <!-- ═══════════════════════════════════════════════════
       UTILITY TOOLS
       ═══════════════════════════════════════════════════ -->
  <Folder Name="/Sample/Utils/">
    <Project Path="Utils/DefinitionManager/DefinitionManager.csproj" />
    <Project Path="Utils/Deploy.XrmFramework.Sample.Plugins/Deploy.XrmFramework.Sample.Plugins.csproj" />
    <Project Path="Utils/RemoteDebugger/RemoteDebugger.csproj" />
  </Folder>

  <!-- ═══════════════════════════════════════════════════
       FRAMEWORK SOURCE PROJECTS (for debugging)
       These projects are included to allow navigation
       through the source code and step-by-step debugging.
       ═══════════════════════════════════════════════════ -->
  <Folder Name="/Framework/">
    <Project Path="../src/XrmFramework.Core/XrmFramework.Core.csproj" />
    <Project Path="../src/XrmFramework.CoreProject/XrmFramework.CoreProject.csproj" />
    <Project Path="../src/XrmFramework.DefinitionManager/XrmFramework.DefinitionManager.csproj" />
    <Project Path="../src/XrmFramework.DeployUtils/XrmFramework.DeployUtils.csproj" />
    <Project Path="../src/XrmFramework.Plugin/XrmFramework.Plugin.csproj" />
    <Project Path="../src/XrmFramework.RemoteDebugger.Client/XrmFramework.RemoteDebugger.Client.csproj" />
    <Project Path="../src/XrmFramework/XrmFramework.csproj" />
  </Folder>

</Solution>
