<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Consumer test project — demonstrates how to use the XrmFramework.Plugin.Tests
    and XrmFramework.Core.Tests packages to measure the Framework's
    code coverage.

    How it works
    ──────────────────────────
    XrmFramework.Plugin.Tests and XrmFramework.Core.Tests are "source-only"
    packages: they ship their test .cs files via contentFiles
    (buildAction=Compile). These sources are therefore compiled INTO this
    assembly, alongside the Framework's own sources (provided the same way by
    XrmFramework.Plugin / XrmFramework.Core via their own contentFiles).

    Result: the code coverage reported by coverlet.collector applies
    directly to the Framework code, not to a separate assembly.

    To run the tests and obtain coverage:
      dotnet test --collect:"XPlat Code Coverage"
  -->

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Reference to the Framework's test packages.
      These two packages transitively bring in:
        - XrmFramework.Plugin  -> Framework Plugin sources (contentFiles)
        - XrmFramework.Core    -> base type sources (contentFiles)
        - MSTest.TestFramework, MSTest.TestAdapter
        - Microsoft.NET.Test.Sdk
        - coverlet.collector (via the .props file injected by NuGet)
    -->
    <PackageReference Include="XrmFramework.Plugin.Tests" Version="$(XrmFrameworkVersion)" />
    <PackageReference Include="XrmFramework.Tests"   Version="$(XrmFrameworkVersion)" />

    <!--
      Microsoft.NET.Test.Sdk must be referenced DIRECTLY in the test
      project for the test runner to be enabled.
    -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
  </ItemGroup>

</Project>
