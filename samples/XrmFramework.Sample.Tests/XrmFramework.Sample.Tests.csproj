<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Projet de tests consommateur — illustre comment utiliser les packages
    XrmFramework.Plugin.Tests et XrmFramework.Core.Tests pour mesurer
    la couverture de code du Framework.

    Principe de fonctionnement
    ──────────────────────────
    XrmFramework.Plugin.Tests et XrmFramework.Core.Tests sont des packages
    "source-only" : ils embarquent les fichiers .cs de tests dans contentFiles
    (buildAction=Compile). Ces sources sont donc compilées DANS cet assembly,
    aux côtés des sources du Framework lui-même (fournies de la même façon par
    XrmFramework.Plugin / XrmFramework.Core via leur propre contentFiles).

    Résultat : la couverture de code rapportée par coverlet.collector porte
    directement sur le code du Framework, pas sur un assembly séparé.

    Pour lancer les tests et obtenir la couverture :
      dotnet test --collect:"XPlat Code Coverage"
  -->

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Référence aux packages de tests du Framework.
      Ces deux packages apportent transitivement :
        - XrmFramework.Plugin  → sources du Framework Plugin (contentFiles)
        - XrmFramework.Core    → sources des types de base (contentFiles)
        - MSTest.TestFramework, MSTest.TestAdapter
        - Microsoft.NET.Test.Sdk
        - coverlet.collector (via le fichier .props injecté par NuGet)
    -->
    <PackageReference Include="XrmFramework.Plugin.Tests" Version="$(XrmFrameworkVersion)" />
    <PackageReference Include="XrmFramework.Tests"   Version="$(XrmFrameworkVersion)" />

    <!--
      Microsoft.NET.Test.Sdk doit être référencé DIRECTEMENT dans le projet
      de tests pour que le runner de tests soit activé.
    -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
  </ItemGroup>

</Project>
