<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Plugins project: contains the Dataverse plugins and workflows.
      net462 is required for running plugins in the Dataverse sandbox.
    -->
    <TargetFramework>net462</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Direct reference to the XrmFramework.Plugin project (instead of the NuGet package).
      Allows step-by-step debugging into the framework code.
      XrmFramework.Plugin already includes the XrmFramework sources internally.
    -->
    <ProjectReference Include="../../src/XrmFramework.Plugin/XrmFramework.Plugin.csproj" />
  </ItemGroup>

</Project>
