<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Graphical tool (WinForms) for generating entity definition files.
      net472 is required by XrmFramework.DefinitionManager (WinForms).
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Direct reference to the XrmFramework.DefinitionManager project (instead of the NuGet package).
      This project itself references XrmFramework.Core and XrmFramework.DeployUtils.
    -->
    <ProjectReference Include="../../../src/XrmFramework.DefinitionManager/XrmFramework.DefinitionManager.csproj" />
    <ProjectReference Include="..\..\XrmFramework.Sample.Core\XrmFramework.Sample.Core.csproj" />
  </ItemGroup>


  <!-- samples/Directory.Build.props is automatically imported by MSBuild (directory tree walk-up). -->
  <Import Project="../../../src/XrmFramework.DefinitionManager/build/net462/XrmFramework.DefinitionManager.props" />
</Project>
