<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Remote debugging client: intercepts plugin calls from Dataverse
      and redirects them to the development machine for local debugging.
      A .NET Framework target is required for compatibility with the Dynamics SDKs;
      net48 is the default, net462 is also supported.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference to this sample's Plugins project (to resolve the plugin types to debug) -->
    <ProjectReference Include="$(RootFolder)/XrmFramework.Sample.Plugins/XrmFramework.Sample.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Direct reference to the XrmFramework.RemoteDebugger.Client project (instead of the NuGet package).
      Allows step-by-step debugging into the remote debugging client code.
    -->
    <ProjectReference Include="../../../src/XrmFramework.RemoteDebugger.Client/XrmFramework.RemoteDebugger.Client.csproj" />
  </ItemGroup>

  <Import Project="../../../src/XrmFramework.RemoteDebugger.Client/build/net48/XrmFramework.RemoteDebugger.Client.props" />

</Project>
