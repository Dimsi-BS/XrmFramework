<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Core project: contains the entity definitions, models, and services.
      Targets net10.0 and net462 to be compatible with the deployment tools.
    -->
    <TargetFrameworks>net10.0;net462</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Direct reference to the XrmFramework.CoreProject project (instead of the NuGet package).
      Allows step-by-step debugging into the framework code.
      XrmFramework.CoreProject already includes the XrmFramework sources internally.
    -->
    <ProjectReference Include="../../src/XrmFramework.CoreProject/XrmFramework.CoreProject.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Definitions/" />
    <Folder Include="Model/" />
    <Folder Include="Services/" />
  </ItemGroup>

</Project>
