<Project>
  <PropertyGroup>
    <!-- Root folder of the sample solution, used by the Utils projects -->
    <RootFolder>$(MSBuildThisFileDirectory)</RootFolder>

    <LangVersion>latest</LangVersion>

    <!-- Name of the sample solution's Core project, used by the DefinitionManager -->
    <XrmFrameworkCoreProjectName>XrmFramework.Sample.Core</XrmFrameworkCoreProjectName>

    <!-- The sample projects manage their own dependency versions. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
