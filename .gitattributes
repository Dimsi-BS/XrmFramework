# Normalizes all line endings in the repo to LF.
# The working tree is written in LF on both macOS and Windows
# (Visual Studio, Rider, and the dotnet CLI have handled LF fine since VS 2017+).
# This file takes precedence over core.autocrlf — there is no need (and it is not
# recommended) to also configure autocrlf.

* text=auto eol=lf

# ---------- Sources & projets .NET ----------
*.cs        text eol=lf diff=csharp
*.cshtml    text eol=lf
*.razor     text eol=lf
*.vb        text eol=lf
*.fs        text eol=lf
*.fsx       text eol=lf
*.csproj    text eol=lf
*.vbproj    text eol=lf
*.fsproj    text eol=lf
*.shproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.nuspec    text eol=lf
*.config    text eol=lf
*.runsettings text eol=lf

# ---------- Solutions ----------
# .sln files (legacy format) require CRLF; some MS tools choke on LF.
# The .slnx format (XML, newer) tolerates LF.
*.sln       text eol=crlf
*.slnx      text eol=lf

# ---------- Scripts ----------
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=lf
*.psm1      text eol=lf
*.psd1      text eol=lf
*.sh        text eol=lf

# ---------- Data / config ----------
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.xaml      text eol=lf
*.resx      text eol=lf
*.ruleset   text eol=lf
*.editorconfig text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf

# ---------- Web ----------
*.html      text eol=lf
*.htm       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.less      text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.map       text eol=lf

# ---------- Markdown / docs ----------
*.md        text eol=lf
*.markdown  text eol=lf
*.txt       text eol=lf

# ---------- XrmFramework business files ----------
*.table     text eol=lf
*.model     text eol=lf

# ---------- Binaires ----------
