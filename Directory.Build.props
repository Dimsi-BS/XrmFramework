<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Security: force patched versions of vulnerable transitive dependencies -->
  <ItemGroup>
    <!-- System.Security.Cryptography.Xml 8.0.2 has a known high severity vulnerability (GHSA-37gx-xxp4-5rgx).
         Pulled in transitively by System.ServiceModel.Primitives.
         Central version = net10 (Ver_SecCryptoXmlNet10). net8 uses VersionOverride to pin to its patched build. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Condition="'$(TargetFramework)' == 'net8.0'" VersionOverride="$(Ver_SecCryptoXmlNet8)" />
    <PackageReference Include="System.Security.Cryptography.Xml" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Condition="!Exists('packages.config')">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SourceLink.GitHub" />
  </ItemGroup>

</Project>
